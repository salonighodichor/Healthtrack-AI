# HealTrack AI — Backend environment variables
# Copy to backend/.env for local development:  cp backend/.env.example backend/.env
# On Render, set these in Dashboard -> Environment, NOT in a file.

# --- WSGI server ---
# Command:  gunicorn --chdir backend app:app
# Render Start Command:
#   gunicorn --chdir backend --workers 2 --threads 4 --timeout 120 app:app

# Bind address. Render injects PORT automatically; this is the local default.
PORT=5000

# --- Database ---
# SQLite file location. Defaults to backend/instance/healtrack.db when unset.
# NOTE: Render's filesystem is ephemeral - see README section on persistent disks.
# DATABASE_PATH=/opt/render/project/src/backend/instance/healtrack.db

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Leave unset for local development (app currently allows all origins).
# CORS_ORIGINS=https://healtrack-ai.vercel.app,https://your-frontend.vercel.app

# --- Flask ---
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to 0 in production to disable the Flask debugger.
FLASK_DEBUG=0