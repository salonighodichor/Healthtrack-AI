# HealTrack AI — Frontend environment variables (Vite)
# Vite only loads env vars from the PROJECT ROOT (not src/).
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, set these in Project Settings -> Environment Variables.

# Base URL of the deployed Flask backend (no trailing slash).
# Local development falls back to http://127.0.0.1:5000 when this is unset.
VITE_API_BASE=http://127.0.0.1:5000

# Production value, set this in Vercel:
# VITE_API_BASE=https://healtrack-ai-backend.onrender.com

# NOTE: Vite inlines VITE_* variables into the client bundle at BUILD time.
# Vercel must be configured to rebuild when the value changes, and these
# variables are PUBLIC - never put secrets in this file.